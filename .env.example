# 환경 변수 템플릿
# 이 파일을 .env로 복사한 뒤 값을 채운다. 실제 값은 이 파일에 쓰지 않는다.
# .env는 .gitignore에 등록되어 있어 git에 올라가지 않는다.

# 실행 환경 (local 또는 aws)
APP_ENV=

# football-data.org API 키
FOOTBALL_DATA_API_KEY=

# DB 접속 정보 (로컬: PostgreSQL / AWS: RDS)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# 원본 저장소 (로컬: MinIO / AWS: S3)
# AWS S3를 쓸 때는 S3_ENDPOINT_URL을 비워두면 기본 S3 주소를 사용하도록 구현한다
S3_ENDPOINT_URL=
S3_BUCKET_NAME=

# MinIO 접속 계정 (로컬 전용)
# AWS에서는 비워두고 EC2의 IAM 역할로 접근한다
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# AWS 리전
AWS_REGION=

# LLM API 키 (AI 분석 리포트 구현 단계에서 사용)
LLM_API_KEY=
